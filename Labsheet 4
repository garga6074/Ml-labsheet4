plt.show()

# 34. Save the clustered dataset as a CSV file
output_filename = "clustered_iris_dataset.csv"
df.to_csv(output_filename, index=False)
print(f"\n[Success] Step 34: Clustered dataset successfully saved to '{output_filename}'")

# 35. Summary Performance Breakdown Table
print("\n" + "="*60)
print("Step 35: SUMMARY OF PERFORMANCE FINDINGS")
print("="*60)
print(f"1. K-Means (K=3) Silhouette Score         : {silhouette_score(X_scaled, labels_k3):.4f}")
print(f"2. Hierarchical (Ward) Silhouette Score   : {silhouette_score(X_scaled, labels_ward):.4f}")
print(f"3. Hierarchical (Complete) Silhouette Score: {silhouette_score(X_scaled, labels_complete):.4f}")
