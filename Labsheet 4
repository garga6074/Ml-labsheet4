print(f"Silhouette Score (K=3): {score_k3:.4f}")

# 32. Analyze the characteristics of each cluster using descriptive statistics
df['Hierarchical_Labels'] = labels_ward
print("\n--- Step 32: Cluster Characteristics (Mean Values per K-Means Cluster) ---")
print(df.groupby('KMeans_Labels')[features].mean())

# 33. Visualize cluster distributions using pair plots
# Dropping temporary hierarchical labels for cleaner pairplot tracking K-means
sns.pairplot(df.drop(columns=['Hierarchical_Labels']), hued='KMeans_Labels', palette='Set1')
